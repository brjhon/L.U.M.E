# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://lume:lume@localhost:5432/lume
# Segredos JWT (Sprint 1). Gere valores longos e aleatórios.
JWT_ACCESS_SECRET=troque-isto
JWT_REFRESH_SECRET=troque-isto-tambem
# Google Maps Platform (Sprint 1/2). Opcional no Sprint 0.
GOOGLE_MAPS_API_KEY=
# Proxies confiáveis na frente da API (0 local; 1 atrás do Caddy em produção).
TRUST_PROXY=0
# Contato exigido pelo OpenStreetMap quando não há chave do Google.
GEOCODER_USER_AGENT=
