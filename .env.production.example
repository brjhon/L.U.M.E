# Copie para .env.production NA VPS (nunca commite). Usado por deploy/docker-compose.prod.yml.

# Domínios (precisam apontar, via DNS tipo A, para o IP da VPS).
# Sem domínio próprio ainda? Use o sslip.io: api.203-0-113-10.sslip.io (troque pelo IP da VPS).
API_DOMAIN=api.seudominio.com.br
PAINEL_DOMAIN=painel.seudominio.com.br
# E-mail para avisos do Let's Encrypt (certificados HTTPS).
ACME_EMAIL=voce@seudominio.com.br

# Senha do banco. Gere com: openssl rand -hex 24   (só letras/números: vai dentro de uma URL)
POSTGRES_PASSWORD=

# Geocodificação. Com chave do Google, ela é usada; sem chave, o OpenStreetMap exige contato real.
GOOGLE_MAPS_API_KEY=
GEOCODER_USER_AGENT=lume (voce@seudominio.com.br)

# Ajustes opcionais. Padrões pensados para VPS de 4 GB / 2 vCPU
# (sobra ~1 GB para o sistema, o Caddy e o build das imagens).
# DB_MEMORY_LIMIT=1536m
# API_MEMORY_LIMIT=512m
# WEB_MEMORY_LIMIT=512m
# DATABASE_POOL_MAX=10
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_MAX_CONNECTIONS=50
# PG_LOG_SLOW_MS=500
# BACKUP_KEEP_DAYS=14
