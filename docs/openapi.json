    "/v1/search": {
      "get": {
        "description": "Classifica cada oferta pela cobertura declarada. Por padrão omite quem declara não atender o endereço.",
        "operationId": "SearchController_find_v1",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "description": "Latitude do endereço buscado",
            "schema": {
              "example": -23.5869,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "description": "Longitude do endereço buscado",
            "schema": {
              "example": -46.6395,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Texto livre (sem diferenciar acentos)",
            "schema": {
              "example": "eletricista",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Slug da categoria (inclui subcategorias)",
            "schema": {
              "example": "servicos-gerais",
              "type": "string"
            }
          },
          {
            "name": "mode",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DELIVERY",
                "IN_STORE",
                "AT_HOME",
                "REMOTE"
              ]
            }
          },
          {
            "name": "communityId",
            "required": false,
            "in": "query",
            "description": "Comunidade do usuário, para cobertura do tipo COMMUNITY",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "maxDistanceM",
            "required": false,
            "in": "query",
            "description": "Distância máxima para comércios presenciais e fornecedores sem cobertura declarada",
            "schema": {
              "minimum": 500,
              "maximum": 50000,
              "default": 15000,
              "type": "number"
            }
          },
          {
            "name": "includeNotServed",
            "required": false,
            "in": "query",
            "description": "Incluir, separados, os que declaram não atender o endereço",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos"
          }
        },
        "summary": "Busca ofertas para um endereço",
        "tags": [
          "search"
        ]
      }
    },
