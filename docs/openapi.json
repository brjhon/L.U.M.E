    "/v1/geocode": {
      "get": {
        "description": "Permite buscar sem GPS (LGPD: localização precisa só com autorização).",
        "operationId": "GeocodingController_find_v1",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "description": "Endereço ou CEP",
