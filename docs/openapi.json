  "info": {
    "title": "API L.U.M.E.",
    "description": "Localizador Unificado de Mercados e Especialistas",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Maria Souza"
          },
          "email": {
            "type": "string",
            "example": "maria@exemplo.com.br"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "phone": {
            "type": "string",
            "example": "5511999990000",
            "description": "Só dígitos, com DDI e DDD"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "PARTNER",
              "PLATFORM_ADMIN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "role",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Segundos até o token de acesso expirar"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@exemplo.com.br"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token recebido no login ou na última renovação"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "null remove o telefone"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Senha atual, para confirmar que é o dono da conta"
          }
        },
        "required": [
          "password"
        ]
      },
      "CategorySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "SearchProviderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "PROFESSIONAL"
            ]
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "displayName"
        ]
      },
      "SearchResultItemDto": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "DELIVERY",
              "IN_STORE",
              "AT_HOME",
              "REMOTE"
            ]
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "UNCONFIRMED",
              "NOT_SERVED"
            ],
            "nullable": true,
            "description": "Só para DELIVERY e AT_HOME. \"Atende seu endereço\" apenas quando CONFIRMED."
          },
          "distanceM": {
            "type": "number",
            "nullable": true
          },
          "category": {
            "$ref": "#/components/schemas/CategorySummaryDto"
          },
          "provider": {
            "$ref": "#/components/schemas/SearchProviderDto"
          }
        },
        "required": [
          "listingId",
          "title",
          "description",
          "mode",
          "eligibility",
          "distanceM",
          "category",
          "provider"
        ]
      },
      "SearchResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultItemDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "hasMore"
        ]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "Nome do ícone Material"
          },
          "sensitive": {
            "type": "boolean",
            "description": "Categoria com controles reforçados (ex.: cuidadores)"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "icon",
          "sensitive",
          "children"
        ]
      },
      "GeoPointDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "ProviderLocationDto": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPointDto"
          }
        },
        "required": [
          "address",
          "location"
        ]
      },
      "ListingProviderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "BUSINESS",
              "PROFESSIONAL"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "whatsapp": {
            "type": "string",
            "nullable": true,
            "description": "Número no formato E.164, sem \"+\""
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderLocationDto"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "displayName",
          "description",
          "phone",
          "whatsapp",
          "locations"
        ]
      },
      "ListingDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "DELIVERY",
              "IN_STORE",
              "AT_HOME",
              "REMOTE"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/CategorySummaryDto"
          },
          "provider": {
            "$ref": "#/components/schemas/ListingProviderDto"
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "UNCONFIRMED",
              "NOT_SERVED"
            ],
            "nullable": true
          },
          "distanceM": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
